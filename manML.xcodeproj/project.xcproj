{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "signing.xcconfig" },
    { "name": "Release", "file": "signing.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "path": "signing.xcconfig" },
    { "path": "TODO.md", "target-membership": [ "manML/resources" ] },
    { "path": "Notes.txt", "target-membership": [ "manML/resources" ] },
    { "path": "README.md", "target-membership": [ "manML/resources" ] },
    { "kind": "folder", "path": "Resources", "target-membership": [ "manML" ] },
    { "kind": "folder", "path": "mandoc", "target-membership": [ "manML" ] },
    {
      "kind": "folder",
      "path": "manML",
      "target-membership": [
        "manML",
      ],
      "membership-exceptions": [
        {
          "target": "manML",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/WebKit.framework", "target-membership": [ "manML/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/manML.app", "id": "E71176602CE0411C00236F4A", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "manML",
      "id": "E711765F2CE0411C00236F4A",
      "product": "Products/manML.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": "signing.xcconfig" },
        { "name": "Release", "file": "signing.xcconfig" },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CLANG_ENABLE_OBJC_WEAK": "YES",
        "CODE_SIGN_ENTITLEMENTS": "manML/manML.entitlements",
        "CODE_SIGN_IDENTITY": "$(inherited)",
        "CURRENT_PROJECT_VERSION": "6.0.2",
        "DEAD_CODE_STRIPPING": "YES",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_RESOURCE_ACCESS_AUDIO_INPUT": "NO",
        "ENABLE_RESOURCE_ACCESS_BLUETOOTH": "NO",
        "ENABLE_RESOURCE_ACCESS_CALENDARS": "NO",
        "ENABLE_RESOURCE_ACCESS_CAMERA": "NO",
        "ENABLE_RESOURCE_ACCESS_CONTACTS": "NO",
        "ENABLE_RESOURCE_ACCESS_LOCATION": "NO",
        "ENABLE_RESOURCE_ACCESS_PRINTING": "NO",
        "ENABLE_RESOURCE_ACCESS_USB": "NO",
        "ENABLE_USER_SELECTED_FILES": "readwrite",
        "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
          "DEBUG=1",
          "$(inherited)",
        ],
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "manML/Info.plist",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.developer-tools",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "Copyright (c) 1868 Charles Babbage",
        "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "1.0.2",
        "PRODUCT_BUNDLE_IDENTIFIER": "software.tinker.manML",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "$(inherited)",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_VERSION": "6.0",
        "VERSIONING_SYSTEM": "apple-generic",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
